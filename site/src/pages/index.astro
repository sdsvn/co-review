---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import logo from '../assets/logo.svg?url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}/`;
const github = 'https://github.com/sdsvn/co-review';

/** How each harness installs Co-Review and starts a review. `install` is what the hero's copy box shows. */
type Harness = { id: string; name: string; where: string; install: string[]; file?: boolean; skills?: boolean; use: { cmd?: string; say?: string; what: string }[]; guide: string };
const say = 'Review this change with me in Co-Review.';
const skills = 'npx skills add sdsvn/co-review';
const harnesses: Harness[] = [
	{ id: 'claude', name: 'Claude Code', where: 'In Claude Code', install: ['/plugin marketplace add sdsvn/co-review', '/plugin install co-review@co-review'],
		use: [{ cmd: '/co-review:review', what: 'when a change is ready: it opens the review and stays in it until you submit' }, { cmd: '/co-review:design <task>', what: 'to design first: it writes a design doc, you review it, it builds what you approved' }],
		guide: docs('start/claude-code') },
	{ id: 'pi', name: 'Pi', where: 'In a terminal', install: ['pi install /path/to/co-review/integrations/pi'],
		use: [{ cmd: '/co-review', what: 'opens a review; your questions arrive in the session as you ask them' }, { cmd: '/co-review-design <task>', what: 'to design first' }],
		guide: `${docs('guides/connect-your-agent')}#pi` },
	{ id: 'codex', name: 'Codex', where: 'In ~/.codex/config.toml', file: true, install: ['[mcp_servers.co-review]', 'command = "co-review"', 'args = ["mcp"]', 'tool_timeout_sec = 600'], skills: true,
		use: [{ say, what: 'Codex opens the review, answers your comments, and waits for your verdict' }],
		guide: `${docs('guides/connect-your-agent')}#codex` },
	{ id: 'cursor', name: 'Cursor', where: 'In ~/.cursor/mcp.json', file: true, install: ['{ "mcpServers": { "co-review": { "command": "co-review", "args": ["mcp"] } } }'], skills: true,
		use: [{ say, what: 'in Agent mode; Cursor opens the review and answers in the threads' }],
		guide: `${docs('guides/connect-your-agent')}#cursor` },
	{ id: 'copilot', name: 'Copilot', where: 'In .vscode/mcp.json', file: true, install: ['{ "servers": { "co-review": { "type": "stdio", "command": "co-review", "args": ["mcp"] } } }'], skills: true,
		use: [{ say, what: 'in VS Code agent mode' }],
		guide: `${docs('guides/connect-your-agent')}#vs-code-copilot-agent-mode` },
	{ id: 'gemini', name: 'Gemini CLI', where: 'In ~/.gemini/settings.json', file: true, install: ['{ "mcpServers": { "co-review": { "command": "co-review", "args": ["mcp"], "timeout": 600000 } } }'], skills: true,
		use: [{ say, what: 'Gemini opens the review and answers your comments' }],
		guide: `${docs('guides/connect-your-agent')}#gemini-cli` },
	{ id: 'opencode', name: 'OpenCode', where: 'In opencode.json', file: true, install: ['{ "mcp": { "co-review": { "type": "local", "command": ["co-review", "mcp"] } } }'], skills: true,
		use: [{ say, what: 'OpenCode opens the review and answers your comments' }],
		guide: `${docs('guides/connect-your-agent')}#opencode` }
];

const steps = [
	{ title: 'Your agent opens its change', body: 'It hands you the diff, the design doc, or the whole repository, and flags what deserves a closer look as proposed findings.' },
	{ title: 'You comment where you read', body: 'On a line, a function, a design step or a diagram node. Select a few lines and ask; the question lands in a thread under the code.' },
	{ title: 'It answers in the thread', body: 'From its own context: it knows what it built and why. Answers link straight to the code they talk about.' },
	{ title: 'You decide', body: 'Approve, request changes or comment. The agent gets every open thread in one batch and comes back for the next round.' }
];

const plugin = [
	{ term: '/co-review:review', code: true, body: 'When a change is ready: Claude opens it for review and stays in it until you submit.' },
	{ term: '/co-review:design', code: true, body: 'Before there is code: Claude writes a design doc, you review it, it builds what you approved.' },
	{ term: 'Live comments', body: 'With channels on, your question reaches the running session the moment you ask it.' },
	{ term: 'co-reviewer', body: 'A background subagent that keeps answering your review while the main conversation works.' },
	{ term: 'Session hook', body: 'Open Claude Code in a repository with waiting questions, and it already knows about them.' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Co-Review: review what your coding agent built</title>
		<meta name="description" content="Co-Review opens your coding agent's work as a review: Claude Code, Pi, Codex, Cursor and more. Comment on code, designs and diagrams; the agent answers in the thread and waits for your verdict." />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="canonical" href={new URL(`${base}/`, Astro.site)} />
		<meta property="og:title" content="Co-Review: review what your coding agent built" />
		<meta property="og:description" content="Comment on code, designs and diagrams. Your agent answers in the thread and waits for your verdict." />
	</head>
	<body>
		<header class="top">
			<a class="brand" href={`${base}/`}><img src={logo} alt="" width="28" height="28" />Co-Review</a>
			<nav aria-label="Main">
				<a href={docs('start/overview')}>Docs</a>
				<a href="#setup">Set up</a>
				<a href={github}>GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="pitch">
					<h1>
						Review what <span class="sr-only">your coding agent</span><span class="harness" aria-hidden="true">{harnesses.map((h, i) =>
							<span data-harness={h.id} class={i === 0 ? 'on' : undefined}>{h.name}</span>)}</span> built. Ask it why.
					</h1>
					<p class="lede">
						Co-Review opens your agent's work as a review: code, designs, diagrams. You comment the way you would on a
						pull request, and the agent answers in the thread, from the context of what it just did.
					</p>
					{harnesses.map((h, i) =>
						<div class="install" data-harness={h.id} data-copy={h.install.join('\n')} hidden={i !== 0}>
							<p class="where">{h.where}</p>
							<pre class={h.file ? 'file' : undefined}><code>{h.install.map(line => <span class="cmd">{line}</span>)}</code></pre>
							<button type="button" class="copy">Copy</button>
						</div>)}
					<p class="after">
						Needs the Co-Review app and its <a href={docs('start/install')}>co-review command</a>.
						<a class="docs-link" href="#setup">Set up another agent</a>
					</p>
				</div>

				<figure class="demo" aria-label="A review thread in Co-Review">
					<div class="window">
						<div class="bar"><span class="file">internal/orders/service.go</span><span class="agent-on"><span class="agent-name">Claude Code</span> is listening</span></div>
						<ol class="code" start="28">
							<li><span class="k">if</span> err := tx.<span class="f">ReserveInventory</span>(ctx, o.Items); err != <span class="k">nil</span> {'{'}</li>
							<li>    <span class="k">return</span> fmt.<span class="f">Errorf</span>(<span class="s">"reserve: %w"</span>, err)</li>
							<li>{'}'}</li>
							<li class="marked"><span class="mark"><span class="k">if</span> err := s.repo.<span class="f">Save</span>(ctx, o); err != <span class="k">nil</span> {'{'}</span></li>
						</ol>
						<div class="thread">
							<div class="thread-inner">
								<div class="msg you">
									<span class="who">You</span>
									<p><code>repo.Save</code> doesn't take <code>tx</code>. If the charge below fails, does the deferred rollback undo the saved order?</p>
								</div>
								<div class="msg agent">
									<span class="who agent-name">Claude Code</span>
									<p class="answer">No. <code>repo.Save</code> writes through the repository's own connection, so the order is committed as soon as it returns. The deferred <code>tx.Rollback()</code> at <a class="ref">service.go:26</a> only undoes the reservation. Pass the transaction in: <code>s.repo.WithTx(tx).Save(ctx, o)</code>.</p>
								</div>
							</div>
						</div>
						<ol class="code" start="32">
							<li>    <span class="k">return</span> fmt.<span class="f">Errorf</span>(<span class="s">"save: %w"</span>, err)</li>
							<li>{'}'}</li>
						</ol>
					</div>
				</figure>
			</section>

			<section class="setup" id="setup" aria-labelledby="setup-title">
				<h2 id="setup-title">Set up your agent</h2>
				<p class="setup-lede">
					Every agent reviews through the same MCP server, <code>co-review mcp</code>. Claude Code and Pi get native packages; the
					others add the server to their config and, optionally, the skills.
				</p>
				<div class="tabs" role="tablist" aria-label="Agent">
					{harnesses.map((h, i) =>
						<button type="button" role="tab" id={`tab-${h.id}`} aria-controls={`panel-${h.id}`} aria-selected={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1} data-harness={h.id}>{h.name}</button>)}
				</div>
				{harnesses.map((h, i) =>
					<div class="panel" role="tabpanel" id={`panel-${h.id}`} aria-labelledby={`tab-${h.id}`} data-harness={h.id} hidden={i !== 0}>
						<div>
							<h3>Install</h3>
							<p class="where">{h.where}</p>
							<pre class={h.file ? 'file' : undefined}><code>{h.install.map(line => <span class="cmd">{line}</span>)}</code></pre>
							{h.skills && <>
								<p class="where">Then add the skills, so plain requests start the workflow</p>
								<pre><code><span class="cmd">{skills}</span></code></pre>
							</>}
						</div>
						<div>
							<h3>Use</h3>
							<dl class="uses">
								{h.use.map(u => <div><dt>{u.cmd ? <code>{u.cmd}</code> : <q>{u.say}</q>}</dt><dd>{u.what}</dd></div>)}
							</dl>
							<a href={h.guide}>{h.name} setup guide</a>
						</div>
					</div>)}
			</section>

			<section class="steps" aria-labelledby="steps-title">
				<h2 id="steps-title">How a review goes</h2>
				<ol>
					{steps.map(step => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
				</ol>
			</section>

			<section class="beyond" aria-labelledby="beyond-title">
				<div class="beyond-copy">
					<h2 id="beyond-title">Review the design before the code exists</h2>
					<p>
						Claude writes the plan as a design tree: what happens, then how, then the edge cases. You comment on the step
						that worries you, it answers or revises, and it only builds what you approved.
					</p>
					<dl class="kinds">
						<div><dt>Code</dt><dd>Lines, ranges, functions, files, or the whole repository. Comments follow the code through edits.</dd></div>
						<div><dt>Designs</dt><dd>Markdown with a foldable step tree and a checked format.</dd></div>
						<div><dt>Diagrams</dt><dd>Mermaid, down to a single node or edge.</dd></div>
						<div><dt>Patches</dt><dd>Pull-request pages with line comments and suggested edits.</dd></div>
					</dl>
					<a href={docs('guides/design-docs')}>How design documents work</a>
				</div>
				<div class="tree" aria-label="A design document under review">
					<p class="tree-title">Design <span class="levels"><span>L1</span><span class="on">L2</span><span>L3</span></span></p>
					<ul>
						<li><strong>Save the order and a charge request together</strong> <em>one transaction, no network calls inside it</em>
							<ul><li>insert a <code>charge_requested</code> row keyed by order id <span class="badge new" title="new artifact">✎</span> <em>new payment_outbox table</em></li></ul>
						</li>
						<li><strong>Charge from a background worker</strong> <em>at-least-once, safe to retry</em>
							<ul>
								<li>call the provider with the order id as idempotency key</li>
								<li class="commented">mark the row sent, or retry with backoff <span class="badge risk" title="risk">⚠</span> <em>a charge can succeed while the mark fails</em>
									<div class="note"><span class="who">You</span> If we crash before marking the row, does the worker charge twice?</div>
								</li>
							</ul>
						</li>
					</ul>
				</div>
			</section>

			<section class="claude" aria-labelledby="claude-title">
				<div>
					<h2 id="claude-title">Made for Claude Code</h2>
					<p>One plugin gives Claude Code the review tools, the workflows and the slash commands to use them.</p>
					<p class="others">
						Works with Pi, Codex, Cursor, VS Code, Zed, Gemini CLI and any other MCP agent too.
						<a href={docs('guides/connect-your-agent')}>Connect your agent</a>
					</p>
				</div>
				<dl class="plugin">
					{plugin.map(item => <div><dt>{item.code ? <code>{item.term}</code> : item.term}</dt><dd>{item.body}</dd></div>)}
				</dl>
			</section>

			<section class="get" aria-labelledby="get-title">
				<div class="get-inner">
				<h2 id="get-title">Install the app</h2>
				<p>A desktop app for macOS, or a browser app from source on any OS. The review stays on your machine, outside the repository.</p>
				<pre><code><span class="cmd">git clone {github} &amp;&amp; cd co-review</span><span class="cmd">make install &amp;&amp; make install-app</span></code></pre>
				<a href={docs('start/install')}>Install guide</a>
				</div>
			</section>
		</main>

		<footer>
			<span class="brand small"><img src={logo} alt="" width="20" height="20" />Co-Review</span>
			<nav aria-label="Footer">
				<a href={docs('start/overview')}>Docs</a>
				<a href={github}>GitHub</a>
				<a href={`${base}/llms.txt`}>llms.txt for agents</a>
			</nav>
		</footer>

		<script>
			// Copy the install commands.
			document.querySelectorAll<HTMLElement>('[data-copy]').forEach(box => {
				const button = box.querySelector<HTMLButtonElement>('.copy')!;
				button.addEventListener('click', async () => {
					await navigator.clipboard.writeText(box.dataset.copy ?? '');
					button.textContent = 'Copied';
					setTimeout(() => (button.textContent = 'Copy'), 1600);
				});
			});

			// The harness: the headline, the hero's install box, the demo's agent and the setup tabs follow one choice.
			// Until someone picks one, the headline cycles through them (not with reduced motion).
			const ids = [...document.querySelectorAll<HTMLElement>('.harness [data-harness]')].map(e => e.dataset.harness!);
			const names = Object.fromEntries([...document.querySelectorAll<HTMLElement>('.harness [data-harness]')].map(e => [e.dataset.harness, e.textContent]));
			let current = ids[0];
			let chosen = false;
			const select = (id: string, focus = false) => {
				current = id;
				document.querySelectorAll<HTMLElement>('.harness [data-harness]').forEach(e => e.classList.toggle('on', e.dataset.harness === id));
				document.querySelectorAll<HTMLElement>('.install[data-harness], .panel[data-harness]').forEach(e => (e.hidden = e.dataset.harness !== id));
				document.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach(t => {
					const on = t.dataset.harness === id;
					t.setAttribute('aria-selected', String(on));
					t.tabIndex = on ? 0 : -1;
					if (on && focus) t.focus();
				});
				document.querySelectorAll('.agent-name').forEach(e => (e.textContent = names[id] ?? ''));
			};
			const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
			tabs.forEach(tab => {
				tab.addEventListener('click', () => { chosen = true; select(tab.dataset.harness!); });
				tab.addEventListener('keydown', e => {
					const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
					if (step) {
						e.preventDefault();
						chosen = true;
						select(ids[(ids.indexOf(current) + step + ids.length) % ids.length], true);
					}
				});
			});
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const hero = document.querySelector('.hero')!;
				let paused = false;
				hero.addEventListener('mouseenter', () => (paused = true));
				hero.addEventListener('mouseleave', () => (paused = false));
				hero.addEventListener('focusin', () => (paused = true));
				setTimeout(() => {
					const cycle = setInterval(() => {
						if (chosen) return clearInterval(cycle);
						if (!paused) select(ids[(ids.indexOf(current) + 1) % ids.length]);
					}, 2600);
				}, 6000);
			}

			// The one orchestrated moment: the line is marked, the thread opens, the answer streams in.
			const demo = document.querySelector<HTMLElement>('.demo');
			const answer = demo?.querySelector<HTMLElement>('.answer');
			if (demo && answer && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const words = [...answer.childNodes].flatMap(node =>
					node.nodeType === Node.TEXT_NODE
						? (node.textContent ?? '').split(/(\s+)/).filter(Boolean).map(t => document.createTextNode(t))
						: [node]);
				answer.replaceChildren();
				demo.classList.add('playing');
				setTimeout(() => {
					let i = 0;
					const tick = () => {
						if (i < words.length) {
							answer.append(words[i++]);
							setTimeout(tick, 28);
						} else {
							demo.classList.add('done');
						}
					};
					tick();
				}, 1700);
			} else {
				demo?.classList.add('playing', 'done');
			}
		</script>
	</body>
</html>

<style>
	:root {
		--ink: #1e1b4b;
		--ink-2: #45437a;
		--paper: #f7f7fc;
		--rule: #dcdcec;
		--indigo: #4f46e5;
		--indigo-soft: #a5b4fc;
		--mint: #059669;
		--mint-bright: #34d399;
		--highlight: #ffe58a;
		--display: 'Bricolage Grotesque Variable', system-ui, sans-serif;
		--text: 'Hanken Grotesk Variable', system-ui, sans-serif;
		--mono: 'JetBrains Mono Variable', ui-monospace, monospace;
		color-scheme: light;
	}
	* { box-sizing: border-box; }
	html { background: var(--paper); }
	body {
		margin: 0;
		color: var(--ink);
		font: 400 1.0625rem/1.6 var(--text);
		-webkit-font-smoothing: antialiased;
	}
	a { color: var(--indigo); text-underline-offset: 0.18em; }
	a:hover { color: var(--ink); }
	:focus-visible { outline: 2px solid var(--indigo); outline-offset: 3px; border-radius: 4px; }
	h1, h2, h3 { font-family: var(--display); color: var(--ink); margin: 0; }
	code { font-family: var(--mono); font-size: 0.88em; }

	.top, main > section, footer { width: min(1180px, 100% - 3rem); margin-inline: auto; }

	.top { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 0; }
	.brand { display: inline-flex; align-items: center; gap: 0.6rem; font: 700 1.2rem/1 var(--display); color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
	.brand.small { font-size: 1rem; }
	.top nav, footer nav { display: flex; gap: 1.5rem; }
	.top nav a, footer nav a { color: var(--ink-2); text-decoration: none; font-weight: 500; }
	.top nav a:hover, footer nav a:hover { color: var(--indigo); }

	/* Hero: the pitch, and the product's defining moment beside it. */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
		padding: clamp(2.5rem, 7vw, 6rem) 0 clamp(3rem, 7vw, 5.5rem);
	}
	h1 {
		font-size: clamp(2.6rem, 5.4vw, 4.4rem);
		font-weight: 750;
		font-stretch: 88%;
		line-height: 1.02;
		letter-spacing: -0.035em;
		max-width: 12ch;
	}
	.lede { font-size: 1.2rem; color: var(--ink-2); max-width: 46ch; margin: 1.4rem 0 1.8rem; }
	.install { position: relative; max-width: 34rem; }
	.install pre { padding-right: 5.2rem; }
	.install .copy { top: calc(1.4rem + 0.45rem + 0.6rem); }
	pre {
		margin: 0;
		padding: 1rem 1.1rem;
		background: #fff;
		border: 1px solid var(--rule);
		border-radius: 10px;
		overflow-x: auto;
		font: 400 0.9rem/1.7 var(--mono);
	}
	.cmd { display: block; white-space: pre; }
	.cmd::before { content: '> '; color: var(--indigo-soft); user-select: none; }
	.copy {
		position: absolute; top: 0.6rem; right: 0.6rem;
		font: 600 0.85rem/1 var(--text);
		padding: 0.5rem 0.8rem;
		border: 0; border-radius: 7px;
		background: var(--indigo); color: #fff; cursor: pointer;
	}
	.copy:hover { background: var(--ink); }
	.after { font-size: 0.95rem; color: var(--ink-2); margin: 0.9rem 0 0; max-width: 34rem; }
	.docs-link { display: inline-block; margin-left: 0.6rem; font-weight: 600; }

	.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	/* The harness name: every name in one grid cell, so the headline keeps the width of the longest. */
	.harness { display: inline-grid; vertical-align: bottom; }
	/* Marked like the commented line in the review below: a highlighter stroke under the lower half. */
	.harness > span { background: linear-gradient(transparent 58%, var(--highlight) 58%, var(--highlight) 92%, transparent 92%); padding: 0 0.06em; }
	.harness > span { grid-area: 1 / 1; opacity: 0; transform: translateY(0.18em); transition: opacity 0.35s ease, transform 0.35s ease; white-space: nowrap; }
	.harness > span.on { opacity: 1; transform: none; }
	.where { margin: 0 0 0.45rem; font-size: 0.9rem; color: var(--ink-2); }

	/* Set up your agent */
	.setup { padding: clamp(3rem, 6vw, 5rem) 0; border-top: 1px solid var(--rule); }
	.setup-lede { color: var(--ink-2); max-width: 60ch; margin: 1rem 0 1.8rem; }
	.tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.6rem; }
	.tabs button {
		font: 600 0.95rem/1 var(--text); color: var(--ink-2);
		padding: 0.6rem 0.95rem; border-radius: 999px;
		border: 1px solid var(--rule); background: #fff; cursor: pointer;
	}
	.tabs button:hover { border-color: var(--indigo-soft); color: var(--ink); }
	.tabs button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
	.panel { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(1.5rem, 4vw, 3.5rem); }
	.panel[hidden] { display: none; }
	.panel h3 { font-size: 1.15rem; font-weight: 680; margin-bottom: 0.8rem; }
