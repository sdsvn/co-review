---
// The landing page, implemented from the Claude Design file "Co-Review Landing" (kept visually identical; the
// header and footer carry the Co-Review logo).
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import logo from '../assets/logo.svg?url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}/`;
const github = 'https://github.com/sdsvn/co-review';
const installLine = `curl -fsSL https://sdsvn.github.io${base}/install.sh | bash`;

const words = ['your coding agent', 'Claude Code', 'Pi', 'Oh My Pi', 'Codex', 'Cursor', 'Copilot', 'Gemini CLI', 'OpenCode'];
const question = "repo.Save doesn't take tx. If the charge below fails, does the deferred rollback undo the saved order?";
const guide = docs('guides/connect-your-agent');
const ask = '"Review this entire repository with me in Co-Review."';
const mcpNote = (name: string) => `Add the co-review mcp server to ${name}'s MCP config. Adding the skills is optional.`;
const agents: { name: string; installNote?: string; install?: string; use: { cmd: string; desc: string }[]; guide: string }[] = [
	{ name: 'Claude Code', installNote: 'In Claude Code:', install: '/plugin marketplace add sdsvn/co-review\n/plugin install co-review@co-review', use: [
		{ cmd: '/co-review:audit [focus]', desc: 'Reviews the whole repository with you: splits it into areas, proposes findings in each, then answers your questions.' },
		{ cmd: '/co-review:review', desc: 'When a change is ready: it opens the review and stays in it until you submit.' },
		{ cmd: '/co-review:design <task>', desc: 'To design first: it writes a design doc, you review it, it builds what you approved.' }], guide: docs('start/claude-code') },
	{ name: 'Pi', installNote: 'Pi has a native package that ships with Co-Review:', install: 'co-review setup pi', use: [
		{ cmd: '/co-review-audit [focus]', desc: 'Reviews the whole repository with you, area by area.' },
		{ cmd: '/co-review', desc: 'Opens a review; your questions arrive in the session as you ask them.' }], guide: `${guide}#pi-and-oh-my-pi` },
	{ name: 'Oh My Pi', installNote: 'Oh My Pi has a native package that ships with Co-Review:', install: 'co-review setup omp', use: [
		{ cmd: '/co-review-audit [focus]', desc: 'Reviews the whole repository with you, area by area.' },
		{ cmd: '/co-review', desc: 'Only the main session listens; spawn a task subagent to keep answering while you work.' }], guide: `${guide}#pi-and-oh-my-pi` },
	{ name: 'Codex', use: [{ cmd: ask, desc: 'Codex opens the review, answers your comments and waits for your verdict.' }], guide: `${guide}#codex` },
	{ name: 'Cursor', use: [{ cmd: ask, desc: 'In Agent mode, Cursor opens the review and answers in the threads.' }], guide: `${guide}#cursor` },
	{ name: 'Copilot', use: [{ cmd: ask, desc: 'In VS Code agent mode.' }], guide: `${guide}#vs-code-copilot-agent-mode` },
	{ name: 'Gemini CLI', use: [{ cmd: ask, desc: 'Gemini opens the review and answers your comments.' }], guide: `${guide}#gemini-cli` },
	{ name: 'OpenCode', use: [{ cmd: ask, desc: 'OpenCode opens the review and answers your comments.' }], guide: `${guide}#opencode` }
];
const slug = (name: string) => name.toLowerCase().replace(/\W+/g, '-');
const worksWith = ['Claude Code', 'Pi', 'Oh My Pi', 'Codex', 'Cursor', 'Copilot', 'Gemini CLI', 'OpenCode'];
const story = [
	['01', 'It starts as your code', 'You know where everything lives and why, because you wrote it or read every line.'],
	['02', 'Then it drifts', 'Hundreds of agent changes later, every diff looked fine. The whole? It works, but it no longer feels like yours.'],
	['03', 'So you review it together', 'Once in a while, open the entire repository in Co-Review and read it with the agent that built it. Ask anything; it answers from the code.']
];
const steps = [
	['01', 'Start from the overview', 'An overview page shows where to start, the areas of the code and how they connect. Let the agent go first with proposed findings, grouped by area.'],
	['02', 'Read, and ask where you read', 'Comment on a line, a function, a file or a folder. Select a few lines and ask why; the question lands in a thread under the code.'],
	['03', 'It answers from the code', 'A map of every file and what it defines takes the agent straight to the right place. Answers are short, plain and link to the code.'],
	['04', 'Know what you have covered', 'Mark files as viewed and watch coverage per area. A file changed since you read it counts as unread again.']
];
const uses = [
	['Repository', 'A whole repository', 'Open the entire codebase as one review, to get it back in your head or to check your own work. The overview shows where to start, the agent takes a first pass with findings grouped by area, and coverage tracks what you have read.', 'Review a repository →', docs('start/using') + '#review-a-whole-repository'],
	['Change', 'A change or pull request', 'A single change, a branch against its base, a commit, or a .patch / .diff file opened as a pull-request page — with line comments, suggested edits and one verdict. The review you would do on a PR, wherever the change lives.', 'Review a change →', docs('start/using') + '#review-a-change-or-pull-request'],
	['Design', 'A design, before the code', 'Review the plan, not the source: a design written as an L1 · L2 · L3 tree with Mermaid diagrams. Comment on the step or node that worries you; the agent revises and only builds what you approved.', 'Design before code →', docs('guides/design-docs')]
];
const kinds = [
	['Code', 'Lines, ranges, functions, files or the whole repo. Comments follow the code through edits.'],
	['Designs', 'Markdown with a foldable step tree and a checked format.'],
	['Diagrams', 'Mermaid, down to a single node or edge.'],
	['Patches', 'Pull-request pages with line comments and suggested edits.']
];
const plugin = [
	{ term: '/co-review:audit', code: true, body: 'The whole repository: Claude splits it into areas, proposes findings for you to accept or dismiss, then answers your questions.' },
	{ term: '/co-review:review', code: true, body: 'When a change is ready: Claude opens it for review and stays in it until you submit.' },
	{ term: '/co-review:design', code: true, body: 'Before there is code: Claude writes a design doc, you review it, it builds what you approved.' },
	{ term: 'Live comments', body: 'With channels on, your question reaches the running session the moment you ask it.' },
	{ term: 'co-reviewer subagent', body: 'Keeps answering your review in the background while the main conversation works.' },
	{ term: 'Session hook', body: 'Open Claude Code in a repository with waiting questions, and it already knows about them.' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Co-Review: know your codebase again</title>
		<meta name="description" content="You built it with a coding agent, and now it doesn't feel like yours. Co-Review opens the entire repository as a review so you can read it with the agent that wrote it, ask why, and know your code again. Claude Code, Pi, Oh My Pi, Codex, Cursor and more." />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="canonical" href={new URL(`${base}/`, Astro.site)} />
		<meta property="og:title" content="Co-Review: know your codebase again" />
		<meta property="og:description" content="Review your entire repository with the agent that built it. Ask why, in threads under the code." />
	</head>
	<body>
		<div class="page">
			<header class="top">
				<div class="wrap top-row">
					<a class="brand" href={`${base}/`}><img src={logo} alt="" width="26" height="26" />Co-Review</a>
					<nav aria-label="Main">
						<a href={docs('start/overview')}>Docs</a>
						<a href="#setup">Set up</a>
						<a href={github}>GitHub</a>
						<a class="nav-install" href="#install">Install</a>
					</nav>
				</div>
			</header>

			<section class="wrap hero">
				<div class="pitch">
					<div class="pill"><span class="dot"></span>Review code and designs with your agent</div>
					<h1>You built it with <span class="word" id="agent-word">{words[0]}</span>. Make it yours again.</h1>
					<p class="lede">Months of agent-written changes later, the code works, but you no longer know it. Co-Review opens the entire repository as a review: read it like a pull request, ask the agent why anything is the way it is, and come away knowing your codebase again.</p>
					<div class="install-block">
						<div class="cmdbar">
							<span class="prompt">$</span>
							<code>{installLine}</code>
							<button type="button" class="copy" data-copy={installLine}>Copy</button>
						</div>
						<div class="install-note"><span>macOS and Linux. Installs the app and the <code>co-review</code> command.</span><a href="#setup">Then set up your agent →</a></div>
					</div>
				</div>

				<div class="window" id="demo" aria-label="A review thread in Co-Review">
					<div class="window-bar">
						<span class="lights"><span></span><span></span><span></span></span>
						<span class="file">internal/orders/service.go</span>
						<span class="listening"><span class="dot"></span>Claude Code is listening</span>
					</div>
					<div class="code">
						<div class="ln"><span class="n">28</span><span class="src"><span class="k">if</span> err := tx.ReserveInventory(ctx, o.Items); err != <span class="k">nil</span> {'{'}</span></div>
						<div class="ln"><span class="n">29</span><span class="src">    <span class="k">return</span> fmt.Errorf(<span class="s">"reserve: %w"</span>, err)</span></div>
						<div class="ln"><span class="n">30</span><span class="src">{'}'}</span></div>
						<div class="ln line31 selected"><span class="n">31</span><span class="src"><span class="k">if</span> err := s.repo.Save(ctx, o); err != <span class="k">nil</span> {'{'}</span></div>
						<div class="thread">
							<div class="msg">
								<span class="avatar you">You</span>
								<div class="msg-body"><span class="author">You</span><span class="text"><span id="question">{question}</span><span class="caret" hidden></span></span></div>
							</div>
							<div class="typing" hidden><span class="avatar agent"></span>Claude Code is answering…</div>
							<div class="msg answer">
								<span class="avatar agent">C</span>
								<div class="msg-body"><span class="author">Claude Code</span><span class="text muted">No. <code>repo.Save</code> writes through the repository's own connection, so the order is committed as soon as it returns. The deferred <code>tx.Rollback()</code> at <a href="#demo">service.go:26</a> only undoes the reservation. Pass the transaction in: <code>s.repo.WithTx(tx).Save(ctx, o)</code>.</span></div>
							</div>
						</div>
						<div class="ln"><span class="n">32</span><span class="src">    <span class="k">return</span> fmt.Errorf(<span class="s">"save: %w"</span>, err)</span></div>
						<div class="ln"><span class="n">33</span><span class="src">{'}'}</span></div>
					</div>
				</div>
			</section>

			<div class="band">
				<div class="wrap band-row">
					<span class="label">Works with</span>
					{worksWith.map(name => <span class="strong">{name}</span>)}
					<span>and any MCP agent</span>
				</div>
			</div>

			<section id="ways" class="wrap how">
				<div class="head wide">
					<span class="label accent">Three ways to review</span>
					<h2>A repository, a change, or the design before it.</h2>
					<p>The same review tool, whichever you reach for: read a whole codebase, review a single change the way you'd review a pull request, or review the plan before any code exists.</p>
				</div>
				<ol class="steps">
					{uses.map(([tag, title, body, linkText, href]) =>
						<li><span class="num">{tag}</span><h3>{title}</h3><p>{body}</p><a class="more" href={href}>{linkText}</a></li>)}
				</ol>
			</section>

			<section id="why" class="wrap how">
				<div class="head">
					<span class="label accent">Why Co-Review exists</span>
					<h2>Code you shipped, but no longer know.</h2>
					<p>Building with an agent is fast. Change by change, one diff at a time, the codebase grows past what you hold in your head. Reviewing the whole thing together, once in a while, is how you get it back.</p>
				</div>
				<ol class="steps">
					{story.map(([n, title, body], i) =>
						<li><span class={i === 2 ? 'num done' : 'num'}>{n}</span><h3>{title}</h3><p>{body}</p></li>)}
				</ol>
			</section>

			<section id="how" class="wrap how">
				<div class="head">
					<span class="label accent">How a repository review goes</span>
					<h2>Read the whole codebase with the agent that wrote it.</h2>
				</div>
				<ol class="steps">
					{steps.map(([n, title, body], i) =>
						<li><span class={i === 3 ? 'num done' : 'num'}>{n}</span><h3>{title}</h3><p>{body}</p></li>)}
				</ol>
			</section>

			<section class="wrap block">
				<div class="design-card">
					<div class="design-copy">
						<span class="label accent">Changes and designs too</span>
						<h2 class="h2-sm">Review each change, or the plan before the code.</h2>
						<p>Between repository reviews, your agent hands over a change, a branch or a commit when it's done. Or it writes the plan first, as a design tree: what happens, then how, then the edge cases. You comment on the step that worries you, it answers or revises, and it only builds what you approved.</p>
						<div class="kinds">
							{kinds.map(([title, body]) => <div><span class="kind-title">{title}</span><span>{body}</span></div>)}
						</div>
						<a class="more" href={docs('guides/design-docs')}>How design documents work →</a>
					</div>
					<div class="design-doc">
						<div class="doc-bar">
							<span class="file">design.md</span>
							<span class="levels"><span class="on">L1</span><span class="on">L2</span><span>L3</span></span>
						</div>
						<div class="doc-body">
							<div class="step">
								<div class="step-head"><span class="step-n">1</span><div><div class="step-title">Save the order and a charge request together</div><div class="step-why">one transaction, no network calls inside it</div></div></div>
								<div class="sub row"><span>insert a <code>charge_requested</code> row keyed by order id</span><span class="tag new">new payment_outbox table</span></div>
							</div>
							<div class="step">
								<div class="step-head"><span class="step-n">2</span><div><div class="step-title">Charge from a background worker</div><div class="step-why">at-least-once, safe to retry</div></div></div>
								<div class="sub col">
									<span>call the provider with the order id as idempotency key</span>
									<div class="risk"><span>mark the row sent, or retry with backoff</span><span class="tag warn">a charge can succeed while the mark fails</span></div>
									<div class="note"><span class="avatar you small">You</span><span>If we crash before marking the row, does the worker charge twice?</span></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="setup" class="wrap block">
				<div class="head wide">
					<span class="label accent">Set up your agent</span>
					<h2>One MCP server for every agent.</h2>
					<p>Every agent reviews through <code>co-review mcp</code>. Claude Code, Pi and Oh My Pi get native packages; the others add the server to their config and, optionally, the skills.</p>
				</div>
				<div class="tabs" role="tablist" aria-label="Agent">
					{agents.map((a, i) =>
						<button type="button" role="tab" id={`tab-${slug(a.name)}`} aria-controls={`panel-${slug(a.name)}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{a.name}</button>)}
				</div>
				{agents.map((a, i) =>
					<div class="panel" role="tabpanel" id={`panel-${slug(a.name)}`} aria-labelledby={`tab-${slug(a.name)}`} hidden={i !== 0}>
						<div class="panel-col first">
							<span class="label">1 · Install</span>
							<p>{a.installNote ?? mcpNote(a.name)}</p>
							{a.install && <pre>{a.install}</pre>}
						</div>
						<div class="panel-col">
							<span class="label">2 · Use</span>
							{a.use.map(u => <div class="use"><code>{u.cmd}</code><span>{u.desc}</span></div>)}
							<a class="more" href={a.guide}>{a.name} setup guide →</a>
						</div>
					</div>)}
			</section>

			<section class="wrap block">
				<div class="claude">
					<div class="claude-copy">
						<span class="label accent">Made for Claude Code</span>
						<h2 class="h2-sm">One plugin: review tools, workflows and slash commands.</h2>
						<p>Also works with Pi, Oh My Pi, Codex, Cursor, VS Code, Zed, Gemini CLI and any other MCP agent. <a href={docs('guides/connect-your-agent')}>Connect your agent →</a></p>
					</div>
					<div class="features">
						{plugin.map(p => <div>{p.code ? <code>{p.term}</code> : <span class="kind-title">{p.term}</span>}<span>{p.body}</span></div>)}
						<div class="feature-link"><a href={docs('start/claude-code')}>Claude Code setup guide →</a></div>
					</div>
				</div>
			</section>

			<section id="install" class="install-section">
				<div class="install-card">
					<h2>Install the app</h2>
					<p>One command installs the desktop app and the <code>co-review</code> command on macOS (Apple silicon) and Linux. Run it again to update. Reviews stay on your machine, outside the repository.</p>
					<div class="cmdbar dark">
						<span class="prompt">$</span>
						<code>{installLine}</code>
						<button type="button" class="copy" data-copy={installLine}>Copy</button>
					</div>
					<p class="small">Windows: the installer from the <a href={`${github}/releases/latest`}>latest release</a>. Or <a href={docs('start/install')}>build from source</a>.</p>
				</div>
			</section>

			<footer>
				<div class="wrap footer-row">
					<span class="brand small"><img src={logo} alt="" width="20" height="20" />Co-Review</span>
					<span class="footer-links"><a href={docs('start/overview')}>Docs</a><a href={github}>GitHub</a><a href={`${base}/llms.txt`}>llms.txt for agents</a></span>
				</div>
			</footer>
		</div>

		<script define:vars={{ words, question }}>
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Copy the install command.
			document.querySelectorAll('.copy').forEach(button => {
				button.addEventListener('click', () => {
					navigator.clipboard?.writeText(button.dataset.copy || '');
					document.querySelectorAll('.copy').forEach(b => (b.textContent = 'Copy'));
					button.textContent = 'Copied';
					clearTimeout(button.timer);
					button.timer = setTimeout(() => (button.textContent = 'Copy'), 1600);
				});
			});

			// The agent in the headline.
			const word = document.getElementById('agent-word');
			if (!reduced) {
				let w = 0;
				setInterval(() => { w = (w + 1) % words.length; word.textContent = words[w]; }, 2200);
			}

			// The hero loop (70 ms ticks, 200 per loop): the line is selected, the question is typed, the agent answers.
			const demo = document.getElementById('demo');
			const line = demo.querySelector('.line31');
			const thread = demo.querySelector('.thread');
			const q = document.getElementById('question');
			const caret = demo.querySelector('.caret');
			const typing = demo.querySelector('.typing');
			const answer = demo.querySelector('.answer');
			const LOOP = 200, qStart = 22, qDone = qStart + Math.ceil(question.length / 2);
			const render = t => {
				line.classList.toggle('selected', t >= 12);
				thread.hidden = t < qStart;
				q.textContent = question.slice(0, Math.max(0, Math.min(question.length, (t - qStart) * 2)));
				caret.hidden = !(t >= qStart && t < qDone + 6);
				typing.hidden = !(t >= qDone + 6 && t < qDone + 26);
				answer.hidden = !(t >= qDone + 26);
			};
			if (reduced) {
				render(LOOP - 1);
			} else {
				let t = 0;
				render(t);
				setInterval(() => { t = (t + 1) % LOOP; render(t); }, 70);
			}

			// Set up your agent: tabs.
			const tabs = [...document.querySelectorAll('[role="tab"]')];
			const select = (tab, focus) => {
				tabs.forEach(t => {
					const on = t === tab;
					t.setAttribute('aria-selected', String(on));
					t.tabIndex = on ? 0 : -1;
					document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
				});
				if (focus) tab.focus();
			};
			tabs.forEach((tab, i) => {
				tab.addEventListener('click', () => select(tab));
				tab.addEventListener('keydown', e => {
					const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
					if (step) {
						e.preventDefault();
						select(tabs[(i + step + tabs.length) % tabs.length], true);
					}
				});
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fbfbfd;
		--ink: #1e1b4b;
		--ink-2: #4b4a63;
		--muted: #6b6a80;
		--faint: #a5a4b8;
		--rule: #e6e6ef;
		--indigo: #4f46e5;
		--indigo-tint: #eef2ff;
		--indigo-soft: #a5b4fc;
		--green: #047857;
		--green-dot: #10b981;
		--mint: #34d399;
		--mint-ink: #064e3b;
		--sans: 'Geist Variable', system-ui, sans-serif;
		--mono: 'Geist Mono Variable', ui-monospace, monospace;
	}
	body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
	a { color: var(--indigo); text-decoration: none; }
	a:hover { color: #3730a3; text-decoration: underline; }
	* { box-sizing: border-box; }
	:focus-visible { outline: 2px solid var(--indigo); outline-offset: 2px; border-radius: 4px; }
	code, pre { font-variant-ligatures: none; font-feature-settings: 'liga' 0, 'calt' 0; }
	@keyframes crBlink { 50% { opacity: 0; } }
	[hidden] { display: none !important; }
</style>

<style>
	.page { min-height: 100vh; }
	.wrap { max-width: 1160px; margin: 0 auto; }

	.top { position: sticky; top: 0; z-index: 10; background: rgba(251, 251, 253, 0.88); backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); }
	.top-row { padding: 14px 24px; display: flex; align-items: center; gap: 24px; }
	.brand { display: flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 600; font-size: 16px; text-decoration: none; }
	.brand:hover { color: var(--ink); text-decoration: none; }
	.brand img { border-radius: 7px; }
	.brand.small { font-size: 14px; }
	.top nav { display: flex; gap: 22px; margin-left: auto; font-size: 14px; align-items: center; flex-wrap: wrap; }
	.top nav a { color: var(--ink-2); }
	.top nav .nav-install { background: var(--ink); color: #fff; padding: 8px 14px; border-radius: 8px; font-weight: 500; text-decoration: none; }

	.hero { padding: 72px 24px 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 56px; align-items: center; }
	.pitch { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
	.pill { display: inline-flex; align-self: flex-start; align-items: center; gap: 8px; font: 500 12px var(--mono); color: var(--green); background: #ecfdf5; border: 1px solid #a7f3d0; padding: 5px 10px; border-radius: 999px; }
	.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green-dot); }
